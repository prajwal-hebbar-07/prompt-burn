{
  "name": "prompt-burn",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc -p . && pnpm -r --if-present typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check"
  }
}
